PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public address, e.g. https://gracechurch.example.org (no trailing slash)
SITE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=8

# Created once, on first start. Use a strong password and change it after login.
ADMIN_NAME=Church Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 1 when running behind a reverse proxy such as Nginx/Caddy, 0 locally.
TRUST_PROXY=0

# Logs a reminder while sample content is still visible in the dashboard.
DEMO_BANNER=1
